# === DS5Dongle-ESP / ESP32-S31 — starting sdkconfig defaults ===
#
# ESP32-S31 is a new SoC. Treat every symbol here as a STARTING POINT and
# confirm it against `idf.py menuconfig` for your installed ESP-IDF — some
# symbols carry a chip-specific suffix and a few may not exist yet.
#
# `sdkconfig` itself is generated and git-ignored; edit defaults here so the
# config is reproducible across worktrees / CI / the devcontainer.

# --- CPU: run at full clock (the Pico build needed a 1.2V/320MHz overclock for
#     the Opus encoder; the S31 runs 320 MHz natively, no overclock hack). ---
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y        # confirm symbol name for S31

# --- Bluetooth: Classic BR/EDR is the DualSense link (the whole reason S31 over S3) ---
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# --- USB-OTG device (presents to the host as the DualSense, via esp_tinyusb) ---
# esp_tinyusb is pulled in by main/idf_component.yml; descriptors are app-defined.

# --- PSRAM (S31 supports high-speed DDR PSRAM; enable if your module has it) ---
# CONFIG_SPIRAM=y

# --- Flash size: the 3 MB app partition below needs >=4 MB (S31 modules ship
#     4/8/16 MB). Bump to match your module. ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Custom partition table (room for BT + USB + Opus firmware) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
